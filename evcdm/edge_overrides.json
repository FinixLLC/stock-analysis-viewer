  "rules": [
    {
      "action": "drop",
      "from": "cardinal health|cencora|mckesson",
      "to": "abbvie|lilly|gilead|gild",
      "type": "supplier_to_customer",
      "reason": "Reversed copy: the snippet is the manufacturer's 10-K naming its wholesalers as customers; the manufacturer -> distributor edge already exists."
    },
    {
      "action": "reverse",
      "from": "^almirall",
      "to": "lilly",
      "type": "supplier_to_customer",
      "reason": "Lilly owns lebrikizumab (Ebglyss) and licensed European rights to Almirall: licensor Lilly -> licensee Almirall."
    },
    {
      "action": "drop",
      "from": "^regeneron",
      "to": "^sanofi$",
      "type": "substitute",
      "reason": "Snippet lists Praluent's competitors (Repatha, Leqvio); Regeneron and Sanofi are partners, not substitutes."
    },
    {
      "action": "retype",
      "from": "hansoh|intellia|tessera",
      "to": "hansoh|intellia|tessera",
      "type": "supplier_to_customer",
      "new_type": "cooperates_with",
      "reason": "License/collaboration agreements extracted in both directions as supply; one cooperation link."
    },
    {
      "action": "retype",
      "from": "^sanofi",
      "to": "^regeneron",
      "type": "supplier_to_customer",
      "new_type": "cooperates_with",
      "reason": "Snippets describe the Sanofi collaboration (joint Phase 3, 'in collaboration with Sanofi'), not Sanofi supplying Regeneron."
    },
    {
      "action": "retype",
      "from": "^pharmacyclics|^bayer",
      "to": "johnson",
      "type": "supplier_to_customer",
      "new_type": "cooperates_with",
      "reason": "IMBRUVICA (co-marketed with Pharmacyclics/AbbVie) and XARELTO (co-developed with Bayer) are collaborations."
    },
    {
      "action": "drop",
